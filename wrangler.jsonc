// Cloudflare Worker 설정 (드럼 전용 계정). 배포: CLOUDFLARE_ACCOUNT_ID=... npx wrangler@4 deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "play",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // /api/* 만 Worker 코드로, 나머지(게임 화면 파일)는 정적 파일로 바로 → 요청 수에 안 셈
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  // D1 (2026-11-21 Neon 에서 옮김). 실제로 D1 을 쓸지는 비밀값 DB_MODE (d1 / 없거나 neon = Neon) — worker/index.js
  "d1_databases": [{ "binding": "DB", "database_name": "okaystra", "database_id": "3b6401ad-5020-40ea-b03e-82abe5384536" }],
  // 서버 코드를 DB 가까이에서 돌림 → DB 왕복이 짧아짐 (무료)
  "placement": { "mode": "smart" },
  // 📴 서버 보관함(Neon) → D1 랭킹 옮기기: D1 하루 한도가 풀리는 UTC 0시(한국 9시)부터 3시간, 10분마다 (server/offbackup.js)
  "triggers": { "crons": ["*/10 0-2 * * *"] },
  "observability": { "enabled": true }
}
