# ===== 콩콩 드럼 서버 설정 =====  (이 파일을 .env 로 복사해서 채우세요)
PORT=3000
NODE_ENV=development

# 쿠키 서명용 비밀값 (아무 긴 랜덤 문자열). production 에선 필수
SESSION_SECRET=

# 인스타 계정 아이디 (@ 빼고)
INSTAGRAM_HANDLE=

# 잠금 방식: open = Lv.4+ 누구나 / follow = 팔로우 인증 후 열림
GATE_MODE=open

# 팔로우 확인: fake = 항상 "팔로우 중" (지금 단계) / real = 인스타 API 로 진짜 확인
FOLLOW_CHECK_MODE=fake

# "DM 보낸 척" 테스트 버튼. 실서비스에서는 false
ALLOW_DEV_SIMULATE=true

# 공유 카드에 찍을 사이트 주소 (예: https://kongkong.example.com)
SITE_URL=

# ----- Meta(인스타) 앱 설정 : 4단계에서 채움 -----
# 앱 대시보드 > 앱 설정 > 기본 설정 > 앱 시크릿 (웹훅 서명 검증용)
IG_APP_SECRET=
# 웹훅 등록할 때 직접 정하는 확인 토큰 (아무 문자열)
IG_VERIFY_TOKEN=
# 인스타그램 로그인 방식의 장기 액세스 토큰 (instagram_business_basic, instagram_business_manage_messages)
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=graph.instagram.com
IG_API_VERSION=v23.0
# DM 으로 "확인 완료!" 답장 보내기
IG_SEND_REPLIES=true
# 웹훅 원문/프로필 응답을 로그로 찍기 (테스트 때 is_user_follow_business 값 확인용)
IG_DEBUG=false
